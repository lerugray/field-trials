+    bell: voice({ verb: 0.8, ratios: Object.freeze([1, 2.01, 3.03, 4.78]), levels: Object.freeze([1, 0.4, 0.22, 0.1]), vol: 0.07, a: 0.006, dScale: 0.85, s: 0.02, r: 1.4, holdScale: 0.4 }),
