   267	  assert.notDeepEqual(resolved.band, NEUTRAL_DEFAULTS.band, 'the app silently fell back to the neutral room');
   268	  assert.deepEqual(resolved.voices.bell.ratios, [1, 2.01, 3.03, 4.78]);
   269	  assert.deepEqual(resolved.voices.bell.levels, [1, 0.4, 0.22, 0.1]);
   270	  for (const name of Object.keys(voiceDefaults)) {
   271	    assert.notDeepEqual(resolved.voices[name], NEUTRAL_DEFAULTS.voices[name], `${name}: override did not change the resolved voice`);
   272	  }
   273	});
   274	
   275	test('PERFORMANCE: chordal parts ring on with a seeded hand drag and ordered 2–5ms string spread', () => {
   276	  for (const [name, track] of Object.entries(TRACKS)) {
   277	    const ev = performedPass(track, 0).filter((e) => e.name === 'pluck');
   278	    assert.ok(ev.length >= 3, `${name}: no chordal part found`);
   279	    if (name !== 'panic') {
   280	      for (const e of ev) assert.ok(e.r > 0.3, `${name}: chord release ${e.r} is still the abrupt default`);
   281	    }
   282	    for (const step of new Set(ev.map((e) => e.i))) {
   283	      const chord = ev.filter((e) => e.i === step);
   284	      const handDrag = chord[0].t - chord[0].nominal;
   285	      assert.ok(handDrag >= -1e-12 && handDrag <= 0.005 + 1e-12, `${name}: hand drag escaped 0–5ms`);
   286	      for (let string = 1; string < chord.length; string++) {
   287	        const spread = chord[string].t - chord[string - 1].t;
   288	        assert.ok(spread >= 0.002 - 1e-12 && spread <= 0.005 + 1e-12,
   289	          `${name}: string ${string} spread was ${(spread * 1000).toFixed(3)}ms`);
   290	      }
   291	    }
   292	  }
   293	});
   294	
   295	test('DETERMINISM: same seed → identical performance; a new seed moves only time and weight', () => {
   296	  for (const [name, track] of Object.entries(TRACKS)) {
   297	    for (let p = 0; p < STRAIN_BARS[name] * 2; p++) {
   298	      const a = performedPass(track, p, { params: { heat: 0.5 }, seed: 4242 });
   299	      const again = performedPass(track, p, { params: { heat: 0.5 }, seed: 4242 });
   300	      assert.deepEqual(again, a, `${name} pass ${p}: the same seed played differently`);
   301	      // A different band seed is a different NIGHT, never a different TUNE.
   302	      const other = performedPass(track, p, { params: { heat: 0.5 }, seed: 99 });
   303	      assert.equal(skeleton(other), skeleton(a), `${name} pass ${p}: the seed changed the notes, not just the performance`);
   304	    }
   305	  }
   306	  // ...and the humanization genuinely responds to the seed (it is not a no-op).
   307	  const one = performedPass(TRACKS.stage, 0, { seed: 4242 }).map((e) => `${e.t}:${e.vol}`).join(',');
   308	  const two = performedPass(TRACKS.stage, 0, { seed: 99 }).map((e) => `${e.t}:${e.vol}`).join(',');
   309	  assert.notEqual(one, two, 'the performance ignores the band seed');
   310	});
