+        const root = [OOM.A2, OOM.D2, OOM.G2, OOM.C2][bar];
+        if (i === 0) s.v.bass(t, root, 0.3, { vol: 0.38 * lift(s, 1, 0.06), cut: 600 });
+        if (i === 4 || i === 8) strum(s, s.v.pluck, t, prog, 0.26, { vol: 0.115 * lift(s, 4, 0.1), wave: 'triangle', r: 0.75 }, 3, 0.005);
