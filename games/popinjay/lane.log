  humanize: Object.freeze({ timingMs: Object.freeze([0, 6]), velocity: Object.freeze([-0.04, 0.04]), swing: 0.04 }),
  releaseTail: 0.25,
  voices: Object.freeze({
    bass: Object.freeze({ humanize: Object.freeze({ timingMs: Object.freeze([0, 0]), swing: 0 }) }),
