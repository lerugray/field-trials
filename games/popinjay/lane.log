+// The performance pass. `drag` is one-sided lateness in seconds; `lift` is a velocity
+// multiplier centred on 1. Both are deterministic functions of the step and the band
+// seed via s.rand — never a wall clock, never Math.random.
+const RND = (s, k) => (s && typeof s.rand === 'function' ? s.rand(k) : 0.5);
