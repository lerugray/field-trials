+  const stepSeconds = 60 / track.bpm / 4;
+  const totalSteps = track.len * cue.passes;
+  const musicSeconds = totalSteps * stepSeconds;
+  const frames = Math.ceil((musicSeconds + tailSeconds) * sampleRate);
