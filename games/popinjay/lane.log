+        if (i === 4 || i === 12) s.v.lead(t + drag(s, 5, 0.005), CORNET[(s.n >> 1) % CORNET.length] * (heat > 0.6 ? 2 : 1), 0.16, { vol: 0.14 + heat * 0.05, wave: 'square' });
