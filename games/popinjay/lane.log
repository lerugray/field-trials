+// where the A strain lilts and pauses.
+const WALTZ_B = chord(['A4', 'C5', 'E5', 'F5', 'D5', 'A4', 'B4', 'D5', 'B4', 'C5', 'B4', 'G4']);
+// The galop's chase figure — the B strain's cornet, doubled in rate against A's.
